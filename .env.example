# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — secrets must come from a secrets manager in production
# (AWS Secrets Manager, HashiCorp Vault, GCP Secret Manager, etc.), .env is for local dev only.

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins (no wildcard in production).
# Include both the admin panel (frontend/) and the public marketing site
# (website/) dev ports here — each runs on its own origin.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Set to true when running behind a reverse proxy / load balancer (enables secure cookies, correct client IPs)
TRUST_PROXY=false

# --- Database (MySQL) ---
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://clinic_app:changeme@localhost:3306/clinic_db"

# --- Redis (optional, used for distributed rate limiting; falls back to in-memory if unset) ---
REDIS_URL=

# --- JWT ---
# Generate strong random secrets, e.g.: openssl rand -hex 64
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=clinic-backend
JWT_AUDIENCE=clinic-clients

# --- Cookies ---
COOKIE_SECRET=replace-with-another-long-random-secret-min-32-chars

# --- Account security ---
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Pricing engine ---
# Max % a counselor/receptionist may discount a patient-specific treatment
# price without doctor/admin approval (see pricing.service.ts).
PRICING_MAX_UNAPPROVED_DISCOUNT_PERCENT=15

# --- Marketing webhooks (optional — required only to accept live ad-platform leads) ---
# Shared HMAC secret used to verify each platform's inbound lead webhook signature.
MARKETING_WEBHOOK_SECRET_FACEBOOK=
MARKETING_WEBHOOK_SECRET_GOOGLE=

# --- Logging ---
LOG_LEVEL=info
