# --- Core ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins (the Next.js site).
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automarket?schema=public

# --- Auth (back-office admin) ---
# Must be at least 32 characters each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=automarket-api
JWT_AUDIENCE=automarket-admin

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Public lead-capture + login endpoints are limited far more tightly.
LEAD_RATE_LIMIT_WINDOW_MS=900000
LEAD_RATE_LIMIT_MAX=15

# --- Pricing / finance defaults ---
# GST on motor insurance premium (%).
INSURANCE_GST_PERCENT=18
# Fallback interest rate (% p.a.) when a lender offer is not selected.
DEFAULT_LOAN_INTEREST_RATE=9.5
